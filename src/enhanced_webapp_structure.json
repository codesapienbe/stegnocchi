{
  "animation_libraries": {
    "framer_motion": {
      "version": "^11.0.0",
      "features": [
        "Mobile-first animations",
        "TypeScript support",
        "Layout animations",
        "Gesture handling",
        "AnimatePresence for mount/unmount",
        "Spring physics",
        "Variants system"
      ],
      "use_cases": [
        "Steganography process visualization",
        "File upload animations",
        "Message encoding/decoding progress",
        "Mobile-friendly transitions"
      ]
    },
    "lottie_react": {
      "version": "^2.4.0",
      "features": [
        "Vector animations from After Effects",
        "Lightweight JSON format",
        "Scalable animations",
        "Mobile optimized",
        "Event callbacks"
      ],
      "use_cases": [
        "Loading animations",
        "Success/error feedback",
        "Onboarding illustrations",
        "Icon animations"
      ]
    },
    "use_gesture": {
      "version": "^10.3.0",
      "features": [
        "Touch gesture handling",
        "Swipe detection",
        "Drag and drop",
        "Pinch to zoom",
        "Mobile-first design"
      ],
      "use_cases": [
        "Image manipulation",
        "Mobile navigation",
        "Touch interactions",
        "File drag-drop"
      ]
    }
  },
  "mobile_first_architecture": {
    "responsive_design": {
      "breakpoints": {
        "mobile": "320px",
        "tablet": "768px",
        "desktop": "1024px"
      },
      "touch_targets": {
        "minimum_size": "44px",
        "spacing": "8px",
        "hover_states": "disabled on touch"
      }
    },
    "react_native_compatibility": {
      "shared_components": [
        "Button",
        "TextInput",
        "View",
        "ScrollView",
        "TouchableOpacity",
        "Modal",
        "Alert"
      ],
      "styling_approach": "StyleSheet.create() compatible",
      "navigation": "React Navigation ready",
      "gestures": "PanGestureHandler compatible"
    }
  },
  "animation_specifications": {
    "encoding_animation": {
      "steps": [
        {
          "name": "file_upload",
          "duration": "0.8s",
          "effect": "Scale up with bounce",
          "description": "Image appears with elastic effect"
        },
        {
          "name": "message_input",
          "duration": "0.5s",
          "effect": "Slide in from bottom",
          "description": "Text field animates into view"
        },
        {
          "name": "encryption_process",
          "duration": "2.0s",
          "effect": "Progress circle with particles",
          "description": "Visual encryption progress"
        },
        {
          "name": "exif_injection",
          "duration": "1.5s",
          "effect": "Data streams into image",
          "description": "Animated data flowing into image"
        },
        {
          "name": "completion",
          "duration": "1.0s",
          "effect": "Success checkmark with confetti",
          "description": "Celebration animation"
        }
      ]
    },
    "decoding_animation": {
      "steps": [
        {
          "name": "image_analysis",
          "duration": "1.2s",
          "effect": "Scanning lines across image",
          "description": "EXIF data detection visualization"
        },
        {
          "name": "data_extraction",
          "duration": "1.8s",
          "effect": "Particles emerge from image",
          "description": "Hidden data being extracted"
        },
        {
          "name": "decryption_process",
          "duration": "2.2s",
          "effect": "Lock opening with key rotation",
          "description": "Decryption visualization"
        },
        {
          "name": "message_reveal",
          "duration": "1.0s",
          "effect": "Text typewriter effect",
          "description": "Message appears character by character"
        }
      ]
    }
  },
  "typescript_enhancements": {
    "strict_typing": {
      "animation_props": "Framer Motion Variants",
      "gesture_handlers": "@use-gesture types",
      "component_props": "Interface definitions",
      "state_management": "Type-safe reducers"
    },
    "custom_types": [
      "SteganographyState",
      "AnimationVariants",
      "GestureHandlers",
      "TouchEvents",
      "FileUploadState"
    ]
  }
}